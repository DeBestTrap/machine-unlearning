{
  "dataset": "cifar10",
  "model": "vit_b_16",
  "pretrained": true,
  "shards": 5,
  "slices": 6,
  "budget": 6,
  "layers_per_slice": 2,
  "sequence_strategy": "cyclic",
  "rank": 16,
  "alpha": 32,
  "scaling": "lora",
  "lora_dropout": 0.1,
  "head_policy": "snapshot",
  "epochs_per_slice": 15,
  "batch_size": 64,
  "learning_rate": 0.002,
  "selection": "longest_prefix",
  "precision": "fp32"
}
